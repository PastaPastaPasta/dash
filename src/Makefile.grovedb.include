# GroveDB build integration
# Builds the Rust FFI library and provides include/link paths

GROVEDB_DIST_DIR = $(srcdir)/grovedb

# Include paths for C and C++ headers (-isystem suppresses warnings from external code)
GROVEDB_CPPFLAGS = -isystem$(GROVEDB_DIST_DIR)/grovedb-ffi/include
GROVEDB_CPPFLAGS += -isystem$(GROVEDB_DIST_DIR)/grovedb-cpp/include

# Rust build configuration
CARGO ?= cargo
CARGO_BUILD_FLAGS = --release -p grovedb-ffi

# Cross-compilation: Map host triplet to Rust target
# RUST_TARGET is set by configure.ac based on --host
if HAVE_RUST_TARGET
CARGO_BUILD_FLAGS += --target $(RUST_TARGET)
GROVEDB_TARGET_DIR = $(GROVEDB_DIST_DIR)/target/$(RUST_TARGET)/release
# Convert RUST_TARGET to underscored form for environment variables
# e.g., x86_64-apple-darwin -> x86_64_apple_darwin
RUST_TARGET_UNDERSCORED = $(subst -,_,$(RUST_TARGET))
else
GROVEDB_TARGET_DIR = $(GROVEDB_DIST_DIR)/target/release
endif

# Platform-specific library name and link flags
if TARGET_DARWIN
GROVEDB_LIB = $(GROVEDB_TARGET_DIR)/libgrovedb_ffi.a
GROVEDB_LDFLAGS = -framework Security -framework CoreFoundation -lpthread -liconv
endif

if TARGET_WINDOWS
# Note: Using GNU toolchain (mingw), so library is libXXX.a, not XXX.lib (MSVC style)
GROVEDB_LIB = $(GROVEDB_TARGET_DIR)/libgrovedb_ffi.a
GROVEDB_LDFLAGS = -lbcrypt -lntdll -lws2_32 -luserenv -lcrypt32
endif

if TARGET_LINUX
GROVEDB_LIB = $(GROVEDB_TARGET_DIR)/libgrovedb_ffi.a
GROVEDB_LDFLAGS = -lpthread -ldl -lm
endif

# Cross-compilation environment for cargo
# The cc crate (used by lz4-sys, zstd-sys, etc.) looks for CC_<target> and CFLAGS_<target>
# We pass the cross-compiler from the depends/ build system via these variables
if HAVE_RUST_TARGET
# For the linker, we need the full CC command (with --target, -isysroot, etc.), not just
# the compiler path. Create a wrapper script that invokes CC with all its flags.
# Strip ccache if present since it's not needed for linking.
GROVEDB_CC_WITHOUT_CCACHE = $(shell echo "$(CC)" | awk '{if ($$1 ~ /ccache/) {for(i=2;i<=NF;i++) printf "%s ", $$i} else {print}}')

# Create wrapper script and cargo config
GROVEDB_CARGO_CONFIG_SETUP = mkdir -p $(GROVEDB_DIST_DIR)/.cargo && \
	wrapper=$(GROVEDB_DIST_DIR)/.cargo/linker-wrapper.sh && \
	printf '%s\n' '#!/bin/sh' 'exec $(GROVEDB_CC_WITHOUT_CCACHE) "$$@"' > $$wrapper && \
	chmod +x $$wrapper && \
	printf '[target.%s]\nlinker = "%s"\n' "$(RUST_TARGET)" "$$wrapper" > $(GROVEDB_DIST_DIR)/.cargo/config.toml

# Base environment for cc crate
GROVEDB_CARGO_ENV = CC_$(RUST_TARGET_UNDERSCORED)="$(CC)" CXX_$(RUST_TARGET_UNDERSCORED)="$(CXX)" AR_$(RUST_TARGET_UNDERSCORED)="$(AR)" CFLAGS_$(RUST_TARGET_UNDERSCORED)="$(CFLAGS)" CXXFLAGS_$(RUST_TARGET_UNDERSCORED)="$(CXXFLAGS)"

# Bindgen needs extra clang args for cross-compilation (esp. for macOS sysroot)
# The sysroot flags (-isysroot, -iwithsysroot, etc.) are in CC, not CFLAGS.
# Extract flags from CC: skip ccache (if present) and compiler path, keep the rest.
# awk: if $1 contains ccache, start from $3; else start from $2
GROVEDB_BINDGEN_FLAGS = $(shell echo "$(CC)" | awk '{if ($$1 ~ /ccache/) {for(i=3;i<=NF;i++) printf "%s ", $$i} else {for(i=2;i<=NF;i++) printf "%s ", $$i}}')
GROVEDB_CARGO_ENV += BINDGEN_EXTRA_CLANG_ARGS_$(RUST_TARGET_UNDERSCORED)="$(GROVEDB_BINDGEN_FLAGS) $(CFLAGS)"
else
GROVEDB_CARGO_CONFIG_SETUP = true
GROVEDB_CARGO_ENV =
endif

# Build rule for the FFI library
$(GROVEDB_LIB):
	@echo "Building GroveDB FFI library..."
	@$(GROVEDB_CARGO_CONFIG_SETUP)
	cd $(GROVEDB_DIST_DIR) && $(GROVEDB_CARGO_ENV) CARGO_TARGET_DIR=$(abs_srcdir)/grovedb/target $(CARGO) build $(CARGO_BUILD_FLAGS)

# Clean rule
clean-grovedb:
	rm -rf $(GROVEDB_DIST_DIR)/target $(GROVEDB_DIST_DIR)/.cargo

.PHONY: clean-grovedb
