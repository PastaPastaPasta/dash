# cxxbridge codegen for the `dash-platform-ffi` component. Compilation
# happens through the umbrella crate `dashrust` (see Makefile.libs.include,
# cargo feature "platform"); this file only generates and distributes the
# C++ side of the bridge.

LIBRUST_PLATFORM_CRATE_DIR = $(top_srcdir)/rust/platform
LIBRUST_PLATFORM_GEN_DIR = $(abs_top_builddir)/rust/platform/gen
LIBRUST_PLATFORM_GEN_SRCDIR = $(abs_top_srcdir)/rust/platform/gen
LIBRUST_PLATFORM_GEN_STAMP = $(LIBRUST_PLATFORM_GEN_DIR)/.cxxbridge-@CXXBRIDGE_REQUIRED_VERSION@
LIBRUST_PLATFORM_GEN_SRCSTAMP = $(LIBRUST_PLATFORM_GEN_SRCDIR)/.cxxbridge-@CXXBRIDGE_REQUIRED_VERSION@
LIBRUST_PLATFORM_MANIFEST = $(LIBRUST_PLATFORM_CRATE_DIR)/Cargo.toml

LIBRUST_PLATFORM_SRCS = \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/lib.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/decode.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/provider.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/st.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/types.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/src/verify.rs

LIBRUST_PLATFORM_TESTS = \
	$(LIBRUST_PLATFORM_CRATE_DIR)/tests/decoders.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/tests/from_proof.rs \
	$(LIBRUST_PLATFORM_CRATE_DIR)/tests/signing.rs

LIBRUST_PLATFORM_CPP = \
	$(LIBRUST_PLATFORM_GEN_DIR)/src/lib.cpp

LIBRUST_PLATFORM_H = \
	$(LIBRUST_PLATFORM_GEN_DIR)/include/rust/cxx.h \
	$(LIBRUST_PLATFORM_GEN_DIR)/include/rust/platform/lib.h

LIBRUST_PLATFORM_INCLUDES = \
	-I$(LIBRUST_PLATFORM_GEN_DIR)/include

LIBRUST_PLATFORM_FILES = \
	$(LIBRUST_PLATFORM_MANIFEST) \
	$(LIBRUST_PLATFORM_SRCS) \
	$(LIBRUST_PLATFORM_TESTS)

$(LIBRUST_PLATFORM_SRCS): ;

$(LIBRUST_PLATFORM_GEN_STAMP): $(CXXBRIDGE)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_at)rm -f $(@D)/.cxxbridge-*
	$(AM_V_at)touch $@

$(LIBRUST_PLATFORM_CPP): $(LIBRUST_PLATFORM_SRCS) $(LIBRUST_PLATFORM_GEN_STAMP)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_GEN)if test -f $(LIBRUST_PLATFORM_GEN_SRCDIR)/src/lib.cpp && \
	  test -f $(LIBRUST_PLATFORM_GEN_SRCSTAMP) && \
	  test $(LIBRUST_PLATFORM_GEN_SRCDIR)/src/lib.cpp -nt $< && \
	  test $(LIBRUST_PLATFORM_GEN_SRCDIR)/src/lib.cpp -nt $(LIBRUST_PLATFORM_GEN_SRCSTAMP) && \
	  test "$(LIBRUST_PLATFORM_GEN_SRCDIR)" != "$(LIBRUST_PLATFORM_GEN_DIR)"; then \
	  cp $(LIBRUST_PLATFORM_GEN_SRCDIR)/src/lib.cpp $@; \
	else \
	  $(CXXBRIDGE) $< -o $@; \
	fi

$(LIBRUST_PLATFORM_GEN_DIR)/include/rust/platform/lib.h: $(LIBRUST_PLATFORM_SRCS) $(LIBRUST_PLATFORM_GEN_STAMP)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_GEN)if test -f $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/platform/lib.h && \
	  test -f $(LIBRUST_PLATFORM_GEN_SRCSTAMP) && \
	  test $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/platform/lib.h -nt $< && \
	  test $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/platform/lib.h -nt $(LIBRUST_PLATFORM_GEN_SRCSTAMP) && \
	  test "$(LIBRUST_PLATFORM_GEN_SRCDIR)" != "$(LIBRUST_PLATFORM_GEN_DIR)"; then \
	  cp $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/platform/lib.h $@; \
	else \
	  $(CXXBRIDGE) $< --header -o $@; \
	fi

# The one-per-tree cxx runtime header (rust::Slice, rust::Vec, rust::Error,
# ...) that the generated bridge header and platform/ffi/signer.h include as
# <rust/cxx.h>. `cxxbridge --header` with no input emits it.
$(LIBRUST_PLATFORM_GEN_DIR)/include/rust/cxx.h: $(LIBRUST_PLATFORM_GEN_STAMP)
	$(AM_V_at)$(MKDIR_P) $(@D)
	$(AM_V_GEN)if test -f $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/cxx.h; then \
	  cp $(LIBRUST_PLATFORM_GEN_SRCDIR)/include/rust/cxx.h $@; \
	else \
	  $(CXXBRIDGE) --header -o $@; \
	fi

cxxbridge-clean-platform:
	$(AM_V_at)rm -rf $(LIBRUST_PLATFORM_GEN_DIR)

cxxbridge-platform: $(LIBRUST_PLATFORM_CPP) $(LIBRUST_PLATFORM_H)

dist-platform: cxxbridge-platform
	$(MKDIR_P) $(distdir)/platform/gen/src
	$(MKDIR_P) $(distdir)/platform/gen/include/rust/platform
	cp $(LIBRUST_PLATFORM_GEN_STAMP) $(distdir)/platform/gen/
	cp $(LIBRUST_PLATFORM_CPP) $(distdir)/platform/gen/src/
	cp $(LIBRUST_PLATFORM_GEN_DIR)/include/rust/cxx.h $(distdir)/platform/gen/include/rust/
	cp $(LIBRUST_PLATFORM_GEN_DIR)/include/rust/platform/lib.h $(distdir)/platform/gen/include/rust/platform/

.PHONY: cxxbridge-platform cxxbridge-clean-platform dist-platform
